+using OpenQA.Selenium;
+using OpenQA.Selenium.Appium;
+using OpenQA.Selenium.Appium.Android;
+using OpenQA.Selenium.Appium.Enums;
+using NUnit.Framework;
+
+namespace SmokeTest.Mobile;
+
+[TestFixture]
+public class SettingsTests
+{
+    private static AndroidDriver? _driver; // 🔴 BUG: static driver (not thread-safe)
+
+    [OneTimeSetUp]
+    public void Setup()
+    {
+        var options = new AppiumOptions();
+        // 🔴 BUG: hardcoded capabilities
+        options.PlatformName = "Android";
+        options.DeviceName = "Pixel 7";
+        options.PlatformVersion = "14.0";
+        options.AddAdditionalAppiumOption("appPackage", "com.android.settings");
+        options.AddAdditionalAppiumOption("appActivity", ".Settings");
+        // 🔴 BUG: hardcoded server URL
+        _driver = new AndroidDriver(new Uri("http://192.168.1.100:4723/"), options);
+    }
+
+    // 🔴 BUG: missing [TearDown] — no driver.Quit() or driver.Dispose()
+
+    [Test]
+    public void OpenSettings_CheckBatteryOption_Exists()
+    {
+        // 🔴 BUG: XPath on mobile without explicit wait
+        var batteryItem = _driver.FindElement(By.XPath("//*[@text='Battery']"));
+        batteryItem.Click();
+
+        // 🔴 BUG: Thread.Sleep as sync
+        Thread.Sleep(1000);
+        Assert.That(_driver.PageSource, Does.Contain("Battery usage"));
+    }
+}
